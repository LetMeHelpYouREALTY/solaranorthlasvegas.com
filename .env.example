# Google Search Console — paste the content value from the HTML tag verification method.
# Server-only (not NEXT_PUBLIC_*). Example: GOOGLE_SITE_VERIFICATION=abc123...
# GOOGLE_SITE_VERIFICATION=

# Optional: public tel: for visible NAP + JSON-LD (must match GBP before enabling).
# E.164 recommended, e.g. +17025551234
# NEXT_PUBLIC_AGENT_PHONE=

# Optional: sameAs URLs for Organization JSON-LD (public profile / maps links only).
# NEXT_PUBLIC_GBP_MAPS_URL=https://maps.google.com/?cid=...
# NEXT_PUBLIC_FACEBOOK_URL=
# NEXT_PUBLIC_INSTAGRAM_URL=
# NEXT_PUBLIC_LINKEDIN_URL=

# Optional: full street address — all four required to show NAP + LocalBusiness in schema/footer.
# Must match Google Business Profile exactly.
# NEXT_PUBLIC_BUSINESS_STREET_ADDRESS=
# NEXT_PUBLIC_BUSINESS_ADDRESS_LOCALITY=
# NEXT_PUBLIC_BUSINESS_ADDRESS_REGION=NV
# NEXT_PUBLIC_BUSINESS_POSTAL_CODE=
# NEXT_PUBLIC_BUSINESS_ADDRESS_COUNTRY=US